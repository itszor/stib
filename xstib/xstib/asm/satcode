; a bit of a general one
; r0 - *sprite (incl. size data)
; r1 - *screen
; r2 - x pos
; r3 - y pos
sat_plot_XxY_noclip_mask_byte
	stmfd sp!,{r4-r9,lr}
	ldmia r0!,{r4,r5}		; x size from sprite data
	add r6,r1,r3,lsl #shift_1
	add r6,r6,r3,lsl #shift_2	; total x320
	add r6,r6,r2			; r6 points at corner address
plot_XxY_n_m_b_loop_0
	mov r7,r6			; screen address copy
	mov r8,r4			; x size (r5 remains y size)
plot_XxY_n_m_b_loop_1
	ldrb r9,[r0],#1
	cmp r9,#0
	strneb r9,[r7],#1
	addeq r7,r7,#1
	subs r8,r8,#1
	bgt plot_XxY_n_m_b_loop_1
	add r6,r6,#screen_width		; screen width
	subs r5,r5,#1
	bgt plot_XxY_n_m_b_loop_0
	ldmfd sp!,{r4-r9,pc}



; r0 - (*infoblock)
;	+0 (r0) sprite
;	+4 (r1) screen
;	+8 (r2) x pos
;      +12 (r3) y pos
;      +16 (r4) length reqd.
sat_plot_barmiddle
	stmfd sp!,{r4-r9,lr}
	ldmia r0,{r0-r4}
	ldr r9,[r0,#4]			; y size of bar
	add r0,r0,#8			; skip size info
	add r6,r1,r3,lsl #shift_1
	add r6,r6,r3,lsl #shift_2	; total x320
	add r6,r6,r2			; r6 points at corner address
barplot_loop_0
	mov r5,r6		; screen pos
	mov r7,r4		; length
	ldrb r8,[r0],#4		; read one, move on [assumes 4 bytes width]
barplot_loop_1
	strb r8,[r5],#1
	subs r7,r7,#1
	bgt barplot_loop_1
	add r6,r6,#screen_width
	subs r9,r9,#1
	bgt barplot_loop_0
	ldmfd sp!,{r4-r9,pc}



; r0 *sprite
; r1 *screen
; r2 *infoblock
;    x pos (left)
;    y pos (top)
;    table x24 of:
;      start (pixel x-offset)
;      increment .@16
sat_plot_squiggled
	stmfd sp!,{r4-r12,lr}
	ldmia r2!,{r3,r4}	; r3 x, r4 y
	add r5,r1,r4,lsl #shift_1
	add r5,r5,r4,lsl #shift_2	; total x320
	add r5,r5,r3			; r5 points at corner address
	mov r8,#24
squiggle_yloop
	ldmia r2!,{r3,r4}		; r3 start, r4 inc
	add r6,r5,r3
	mov r1,#0
squiggle_xloop
	ldrb r7,[r0,r1,asr #16]		; r0 sprite, r1 x-offset in sprite
	add r1,r1,r4			; increment source sprite x-offset
	cmp r7,#0
	strneb r7,[r6],#1			; put pixel, screen_x++
	addeq r6,r6,#1
	cmp r1,#24*65536
	blt squiggle_xloop
	add r5,r5,#screen_width
	add r0,r0,#24			; inc source sprite line
	subs r8,r8,#1
	bgt squiggle_yloop
	ldmfd sp!,{r4-r12,pc}



