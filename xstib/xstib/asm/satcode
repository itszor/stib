sat_plot_16x16_noclip_mask_word
	stmfd sp!,{r4-r12,lr}
	bic r2,r2,#3
	add r4,r1,r3,lsl #shift_1
	add r4,r4,r3,lsl #shift_2	; total x320
	add r2,r4,r2			; r4 points at corner address
	add r1,r0,#256			; 16*16, ie start of mask data
	mov r12,#16
plot_16x16_n_m_w_loop_0
	ldmia r0!,{r3,r4}	; sprite data
	ldmia r1!,{r6,r7}	; mask data
	ldmia r2,{r9,r10}	; from screen
	and r9,r9,r6
	and r10,r10,r7
	orr r9,r9,r3
	orr r10,r10,r4
	stmia r2!,{r9,r10}	; all that for 12 measly pixels!

	ldmia r0!,{r3,r4}	; sprite data
	ldmia r1!,{r6,r7}	; mask data
	ldmia r2,{r9,r10}	; from screen
	and r9,r9,r6
	and r10,r10,r7
	orr r9,r9,r3
	orr r10,r10,r4
	stmia r2!,{r9,r10}		; all that for 12 measly pixels!
	add r2,r2,#screen_width-16	; muddle out new row start
	subs r12,r12,#1
	bgt plot_16x16_n_m_w_loop_0
	ldmfd sp!,{r4-r12,pc}



; r0 - sprite base
; r1 - screen base
; r2 - x pos
; r3 - y pos
sat_plot_16x16_noclip_mask_byte
	stmfd sp!,{r4-r7,lr}
	add r4,r1,r3,lsl #shift_1
	add r4,r4,r3,lsl #shift_2	; total x320
	add r4,r4,r2			; r4 points at corner address
	mov r2,#16
sat_16x16_n_m_b_loop_0
	mov r5,r4
	mov r3,#16
sat_16x16_n_m_b_loop_1
	ldr r7,[r0],#4

	ands r6,r7,#255
	strneb r6,[r5]
	add r5,r5,#1

	mov r7,r7,lsr #8
	ands r6,r7,#255		; PROBABLY not necessary but has 's'
	strneb r6,[r5]		; extension which affx this line
	add r5,r5,#1

	mov r7,r7,lsr #8
	ands r6,r7,#255
	strneb r6,[r5]
	add r5,r5,#1

	mov r7,r7,lsr #8
	ands r6,r7,#255
	strneb r6,[r5]
	add r5,r5,#1		; using ldr probably isn't much faster...

	subs r3,r3,#4
	bgt sat_16x16_n_m_b_loop_1
	add r4,r4,#screen_width	; screen width
	subs r2,r2,#1
	bgt sat_16x16_n_m_b_loop_0
	ldmfd sp!,{r4-r7,pc}



