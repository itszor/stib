	add r4,r4,r3,lsl #shift_2	; total x320
	add r4,r4,r2			; r4 points at corner address
	mov r2,#24
sat_24x24_n_m_b_loop_0
	mov r5,r4
	mov r3,#24
sat_24x24_n_m_b_loop_1
	ldrb r6,[r0],#1
	cmp r6,#0
	strneb r6,[r5],#1	; makes no difference about the ...],#1
	addeq r5,r5,#1
	subs r3,r3,#1
	bgt sat_24x24_n_m_b_loop_1
	add r4,r4,#screen_width		; screen width
	subs r2,r2,#1
	bgt sat_24x24_n_m_b_loop_0
	ldmfd sp!,{r4-r6,pc}



