; r0 - pointer to sprite data (+mask data)
; r1 - pointer to screen start
; r2 - x pos
; r3 - y pos
sat_plot_24x24_noclip_mask_word
	stmfd sp!,{r4-r12,lr}
	bic r2,r2,#3
	add r4,r1,r3,lsl #shift_1
	add r4,r4,r3,lsl #shift_2	; total x320
	add r2,r4,r2			; r4 points at corner address
	add r1,r0,#576			; 24*24, ie start of mask data
	mov r12,#24
plot_24x24_n_m_w_loop_0
	ldmia r0!,{r3,r4,r5}	; sprite data
	ldmia r1!,{r6,r7,r8}	; mask data
	ldmia r2,{r9,r10,r11}	; from screen
	and r9,r9,r6
	and r10,r10,r7
	and r11,r11,r8
	orr r9,r9,r3
	orr r10,r10,r4
	orr r11,r11,r5
	stmia r2!,{r9,r10,r11}	; all that for 12 measly pixels!

	ldmia r0!,{r3,r4,r5}	; sprite data
	ldmia r1!,{r6,r7,r8}	; mask data
	ldmia r2,{r9,r10,r11}	; from screen
	and r9,r9,r6
	and r10,r10,r7
	and r11,r11,r8
	orr r9,r9,r3
	orr r10,r10,r4
	orr r11,r11,r5
	stmia r2!,{r9,r10,r11}		; all that for 12 measly pixels!
	add r2,r2,#screen_width-24	; muddle out new row start
	subs r12,r12,#1
	bgt plot_24x24_n_m_w_loop_0
	ldmfd sp!,{r4-r12,pc}



